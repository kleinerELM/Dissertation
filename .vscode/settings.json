		"Xerogel"
	],
	"latex-workshop.latex.build.forceRecipeUsage": false,
	"latex-workshop.intellisense.citation.backend": "biblatex",
	"todo-tree.tree.scanMode": "workspace",
    "latex-workshop.latex.clean.fileTypes": [
        "%DOCFILE%*.aux",
        "%DOCFILE%*.bbl",
        "%DOCFILE%*.blg",
        "%DOCFILE%*.idx",
        "%DOCFILE%*.ind",
        "%DOCFILE%*.lof",
        "%DOCFILE%*.lot",
        "%DOCFILE%*.out",
        "%DOCFILE%*.toc",
        "%DOCFILE%*.acn",
        "%DOCFILE%*.acr",
        "%DOCFILE%*.alg",
        "%DOCFILE%*.glg",
        "%DOCFILE%*.glo",
        "%DOCFILE%*.gls",
        "%DOCFILE%*.fls",
        "%DOCFILE%*.log",
        "%DOCFILE%*.fdb_latexmk",
        "%DOCFILE%*.snm",
        "%DOCFILE%*.synctex(busy)",
        "%DOCFILE%*.synctex.gz(busy)",
        "%DOCFILE%*.synctex.gz",
        "%DOCFILE%*.nav",
        "%DOCFILE%*.vrb",
        "%DOCFILE%*.tex.bak",
        "%DOCFILE%*-blx.bib",
        "%DOCFILE%*.bcf",
        "%DOCFILE%*.bcf-SAVE-ERROR",
        "%DOCFILE%*.run.xml",
        "%DOCFILE%*.upa",
        "%DOCFILE%*.xdv"
    ],
	"latex-workshop.latex.recipes": [

		{
			"name": "Fast Build Digital",
			"tools": [
				"xelatexmk"
			]
		},
		{
			"name": "Clean & Build Print",
			"tools": [
				"clean",
				"xelatexmk_print"
			]
		},
		{
			"name": "Clean & Build Digital",
			"tools": [
				"clean",
				"xelatexmk"
			]
		},
		{
			"name": "Print & Digital",
			"tools": [
				"clean",
				"xelatexmk_print",
				"xelatexmk",
				"clean"
			]
		},
		{
			"name": "Parallel Print & Digital",
			"tools": [
				"build_parallel_script"
			]
		}
	],
	"latex-workshop.latex.autoBuild.run": "onSave",
	"latex-workshop.latex.recipe.default": "lastUsed"
}
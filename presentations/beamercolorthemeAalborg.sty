\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeAalborg}[2014/09/13 v1.4.0 The Aalborg Beamer Theme]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theme options and definitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%beamer specific options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<presentation>%refers to the first four modes (beamer,handout,second and trans). That is, to all modes except the article mode
{
  \definecolor{beamer@barcolor}{RGB}{0,155,180}% Pantone 3135C (BU turkise)
  \definecolor{beamer@headercolor}{RGB}{148,193,28}% Pantone 308C (BU green)
  \definecolor{beamer@normaltextcolor}{RGB}{0,0,0}% black  
  %\definecolor{highlight}{RGB}{246,145,0}% Pantone 144C (BU orange)
  \definecolor{highlight}{RGB}{0,107,148}% Pantone 376C (BU blue)
  
  \setbeamercolor{structure}{fg=highlight}
  \setbeamercolor{normal text}{fg=beamer@normaltextcolor}
  \setbeamercolor{Aalborg}{fg=beamer@barcolor,bg=beamer@headercolor}
  \setbeamercolor{titlepagecolorbox}{fg=white,bg=beamer@headercolor}
  %\setbeamercolor{structure}{fg=red}
  \setbeamercolor{myfootlinetext}{fg=beamer@normaltextcolor}
}%end of beamer specific options

\mode<all>

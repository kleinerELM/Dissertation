\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemeAalborg}[2014/09/13 v1.4.0 The Aalborg Beamer Theme]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theme options and definitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{tikz}
\usetikzlibrary{external}
%%%theme options
\DeclareOptionBeamer{left}{\def\beamer@sidebarside{left}}
\DeclareOptionBeamer{right}{\def\beamer@sidebarside{right}}
\ExecuteOptionsBeamer{right}
\ProcessOptionsBeamer

\def\beamer@lefttext{left} %used for comparison below
\newlength{\beamer@plainpagewidth}

\usepackage{tabularx} 
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}} % linksbündig mit Breitenangabe
\newcolumntype{C}[1]{>{\centering\arraybackslash}m{#1}} % zentriert mit Breitenangabe
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}} % rechtsbündig mit 

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%beamer specific options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<presentation>%refers to the first four modes (beamer,handout,second and trans). That is, to all modes except the article mode
{
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %templates
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %footline
  \newlength{\beamer@footerskip}
  \setlength{\beamer@footerskip}{\beamer@leftsidebar+0.4cm}
  \setbeamertemplate{footline}{
  {%
    \begin{beamercolorbox}[wd=\paperwidth,ht=.35cm,dp=.35cm,leftskip=\beamer@footerskip]{myfootlinetext}%{author in head/foot}
      \tiny
	  \bfseries
      \vspace*{\baselineskip}
      
      \begin{tabular}[t]{@{}p{\beamer@leftsidebar}L{0.48\textwidth}R{0.10\textwidth}R{0.12\textwidth}@{}}
	 &\inserttitle & \insertdate & \shortauthor \\
      \end{tabular}
    \end{beamercolorbox}
  }}
  
  %title page
  \setbeamertemplate{title page}{%
    
    \BUWtitlebg
    \ifx\beamer@sidebarside\beamer@lefttext% sidebar on the left
      \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@leftsidebar}%
      \hskip-\beamer@leftsidebar%
    \else% sidebar on the right
      \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@rightsidebar}%
    \fi%
    \begin{minipage}[c][\textheight][c]{\beamer@plainpagewidth}
      \vfill
      \centering
      ~
      \begin{beamercolorbox}[wd=0.9\beamer@plainpagewidth,sep=\baselineskip]{}%
          \vspace*{2\baselineskip}
          
	  {\usebeamerfont{author}\shortauthor\,\orcidlink{\orcid}}
% 	  
	  \vspace{-0.65\baselineskip}
	  
	  {\usebeamercolor{Aalborg}\noindent\textcolor{Aalborg.bg}{\rule{9cm}{0.75pt}}}\vspace*{0.8\baselineskip}
	  
    {\usebeamerfont{title}\usebeamercolor[black]{title}\linespread{1.0}\selectfont\bfseries \inserttitle\par}\vspace*{0.4\baselineskip}

	  \textbf{\usebeamerfont{subtitle}\usebeamercolor[gray]{subtitle}\insertsubtitle}\vspace*{\baselineskip}
      \end{beamercolorbox}
      ~
      %\vspace*{\baselineskip}

      \vfill
      {\inserttitlegraphic}\vspace*{\baselineskip}
      
      {\small\usebeamerfont{date}\insertdate}\vspace*{\baselineskip}
    \end{minipage}
  }
  
  %final page
  \defbeamertemplate*{final page}{text}[1]{%
    \ifx\beamer@sidebarside\beamer@lefttext% sidebar on the left
      \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@leftsidebar}%
      \hskip-\beamer@leftsidebar%
    \else% sidebar on the right
      \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@rightsidebar}%
    \fi%
    \begin{minipage}[c][\textheight][c]{\beamer@plainpagewidth}
      \centering\vspace*{\baselineskip}
      \begin{beamercolorbox}[wd=\beamer@plainpagewidth,center,sep=2\baselineskip]{titlepagecolorbox}%
          #1 
      \end{beamercolorbox}
      
      \vspace*{\baselineskip}
      
      {\usebeamerfont{author}\insertauthor}\vspace*{\baselineskip}
         
      {\usebeamerfont{institute}\insertinstitute}
      
      {\usebeamerfont{institute}\institueadress}
    \end{minipage}
  }
  \newcommand{\finalpage}[1]{
    \setbeamertemplate{final page}[text]{#1}
    \usebeamertemplate{final page}
  }
  
  % add the aau waves to the background
  \newcommand{\BUWtitlebg}{%
    \setbeamertemplate{background}{
      \includegraphics[width=\paperwidth,height=\paperheight]{graphics/Background_title_de.pdf}
      \tikzexternaldisable
      %\tikz[overlay] \fill[fill opacity=0.75,fill=white] (0,0) rectangle (-\paperwidth,\paperheight);
      \tikzexternalenable
    }
  }
  
  % use numbers instead of a picture for the references
  \setbeamertemplate{bibliography item}[text]

  %part page
  \AtBeginPart{\frame[plain]{\partpage}} %adds a plain part page as defined below
  \defbeamertemplate*{part page}{Aalborg theme}{%
    \ifx\beamer@sidebarside\beamer@lefttext% sidebar on the left
      \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@leftsidebar}%
      \hskip-\beamer@leftsidebar%
    \else% sidebar on the right
      \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@rightsidebar}%
    \fi%
    \begin{minipage}[c][\textheight-1cm][c]{\beamer@plainpagewidth}
      \centering
      {\usebeamerfont{title}\usebeamercolor[black]{author}{Part \Roman{part}}}\vspace*{\baselineskip}

      {\usebeamerfont{title}\usebeamercolor[black]{title}{\insertpart}}
    \end{minipage}
  }

}%end of beamer specific options

\mode<all>
